---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, categories, tags, heroImage, embedUrl, audioUrl, videoUrl } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title}>
  <article class="post">
    <h1>{title}</h1>
    <p class="muted">
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {categories.length > 0 && <span> · {categories.join(', ')}</span>}
    </p>

    {heroImage && <Image src={heroImage} alt={title} width={1300} height={731} />}
    {embedUrl && (
      <div class="embed">
        <iframe src={embedUrl} title={title} frameborder="0" allowfullscreen loading="lazy"></iframe>
      </div>
    )}
    {videoUrl && <video src={videoUrl} controls />}
    {audioUrl && <audio src={audioUrl} controls />}

    <div class="content">
      <Content />
    </div>

    {tags.length > 0 && <p class="muted tags">Tags: {tags.join(', ')}</p>}

    <p><a href="/blog/">← Back to blog</a></p>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 48px 0;
    max-width: 680px;
  }
  .content {
    margin: 32px 0;
  }
  .content :global(img) {
    margin: 24px 0;
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .embed iframe {
    width: 100%;
    height: 100%;
  }
  .tags {
    text-transform: uppercase;
    font-size: 0.8rem;
  }
</style>
