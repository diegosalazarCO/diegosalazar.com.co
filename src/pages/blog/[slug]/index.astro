---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StandardPost from '../../../templates/blog/StandardPost.astro';
import MicroPost from '../../../templates/blog/MicroPost.astro';
import EmbedPost from '../../../templates/blog/EmbedPost.astro';

const templates = {
  standard: StandardPost,
  micro: MicroPost,
  embed: EmbedPost,
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const Template = templates[post.data.layout];
---

<BaseLayout title={post.data.title}>
  <Template post={post} />
</BaseLayout>
