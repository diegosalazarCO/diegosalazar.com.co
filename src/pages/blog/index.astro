---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts } from '../../lib/content';

const posts = await getSortedPosts();
const categories = [...new Set(posts.flatMap((p) => p.data.categories))].sort();
const aspects = ['tall', 'square', 'wide'] as const;
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  <p class="filter-label muted">Category</p>
  <div class="filter" id="filter-category">
    <span class="filter-indicator" id="indicator-category"></span>
    <button class="filter-btn active" data-filter="all">All</button>
    {categories.map((cat) => (
      <button class="filter-btn" data-filter={cat}>{cat}</button>
    ))}
  </div>

  <section class="masonry" id="grid">
    {posts.map((post, i) => (
      <PostCard post={post} aspect={aspects[i % aspects.length]} />
    ))}
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .masonry {
    padding: 28px 0 56px;
    columns: 1;
    column-gap: 28px;
  }
  @media (min-width: 640px) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 1000px) {
    .masonry {
      columns: 3;
    }
  }
</style>

<script>
  import { moveIndicator, withViewTransition } from '../../lib/filterBar';

  const cards = document.querySelectorAll<HTMLAnchorElement>('#grid .post');
  let activeCategory = 'all';

  function applyFilters() {
    cards.forEach((card) => {
      const cardCategories = card.dataset.categories ?? '';
      const matchesCategory = activeCategory === 'all' || cardCategories.includes(`|${activeCategory}|`);
      card.classList.toggle('is-hidden', !matchesCategory);
    });
  }

  function wireFilterGroup(containerId: string, indicatorId: string, onSelect: (value: string) => void) {
    const container = document.getElementById(containerId);
    const indicator = document.getElementById(indicatorId);
    const buttons = container?.querySelectorAll<HTMLButtonElement>('.filter-btn') ?? [];

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('active')) return;
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (indicator) moveIndicator(indicator, btn);
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        onSelect(btn.dataset.filter ?? 'all');
        withViewTransition(applyFilters);
      });
    });

    const active = container?.querySelector<HTMLButtonElement>('.filter-btn.active');
    if (active && indicator) moveIndicator(indicator, active);
    return { buttons, indicator };
  }

  const category = wireFilterGroup('filter-category', 'indicator-category', (value) => {
    activeCategory = value;
  });

  window.addEventListener('resize', () => {
    const activeCat = document.querySelector<HTMLButtonElement>('#filter-category .filter-btn.active');
    if (activeCat && category.indicator) moveIndicator(category.indicator, activeCat);
  });
</script>
