---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="not-found">
    <h1>404</h1>
    <p>Sorry, this page doesn't exist.</p>
    <a class="accent" href="/">← Back home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 96px 0;
    text-align: center;
  }
</style>
