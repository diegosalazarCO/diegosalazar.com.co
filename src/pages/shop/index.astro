---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mailto } from '../../lib/constants';
---

<BaseLayout title="Shop">
  <section class="shop">
    <h1>Dalexarte</h1>
    <p>Feel free to DM me if you are interested in any of the prints from my photography work.</p>
    <a class="accent" href={mailto('Interested in a Dalexarte print')}>Contact me →</a>
  </section>
</BaseLayout>

<style>
  .shop {
    padding: 64px 0;
    max-width: 480px;
  }
</style>
