---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectTemplate from '../../../templates/portfolio/ProjectTemplate.astro';
import { getSortedProjects, getPrevNext } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, ...getPrevNext(projects, i) },
  }));
}

const { project, prev, next } = Astro.props;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <ProjectTemplate project={project} prev={prev} next={next} />
</BaseLayout>
