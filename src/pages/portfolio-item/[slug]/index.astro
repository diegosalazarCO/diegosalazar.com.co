---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StandardProject from '../../../templates/portfolio/StandardProject.astro';
import VideoProject from '../../../templates/portfolio/VideoProject.astro';
import GalleryProject from '../../../templates/portfolio/GalleryProject.astro';
import { getSortedProjects, getPrevNext } from '../../../lib/content';

const templates = {
  standard: StandardProject,
  video: VideoProject,
  gallery: GalleryProject,
};

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, ...getPrevNext(projects, i) },
  }));
}

const { project, prev, next } = Astro.props;
const Template = templates[project.data.layout];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <Template project={project} prev={prev} next={next} />
</BaseLayout>
