---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostMeta from '../../components/PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, date, categories, tags, heroImage, embedUrl, audioUrl, videoUrl } = post.data;
const { Content } = await render(post);
---

<article class="post">
  <h1>{title}</h1>
  <PostMeta date={date} categories={categories} />

  {heroImage && (
    <Image class="lightbox-img hero-image" src={heroImage} alt={title} width={Math.min(heroImage.width, 1300)} />
  )}
  {embedUrl && (
    <div class="embed">
      <iframe src={embedUrl} title={title} frameborder="0" allowfullscreen loading="lazy"></iframe>
    </div>
  )}
  {videoUrl && <video src={videoUrl} controls />}
  {audioUrl && <audio src={audioUrl} controls />}

  <div class="content">
    <Content />
  </div>

  {tags.length > 0 && <p class="muted tags">Tags: {tags.join(', ')}</p>}

  <p><a href="/blog/">← Back to blog</a></p>
</article>

<style>
  .post {
    padding: 48px 0;
    max-width: 680px;
  }
  .content {
    margin: 32px 0;
  }
  .content :global(img) {
    margin: 24px 0;
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .embed iframe {
    width: 100%;
    height: 100%;
  }
  .tags {
    text-transform: uppercase;
    font-size: 0.8rem;
  }
</style>
