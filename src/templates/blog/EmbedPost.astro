---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostMeta from '../../components/PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, date, categories, tags, embedUrl, audioUrl, videoUrl } = post.data;
const { Content } = await render(post);
---

<article class="post">
  {embedUrl && (
    <div class="embed full-bleed">
      <iframe src={embedUrl} title={title} frameborder="0" allowfullscreen loading="lazy"></iframe>
    </div>
  )}
  {videoUrl && <video class="full-bleed" src={videoUrl} controls />}

  <div class="wrap">
    <h1>{title}</h1>
    <PostMeta date={date} categories={categories} />
    {audioUrl && <audio class="audio" src={audioUrl} controls />}

    <div class="content">
      <Content />
    </div>

    {tags.length > 0 && <p class="muted tags">Tags: {tags.join(', ')}</p>}

    <p><a href="/blog/">← Back to blog</a></p>
  </div>
</article>

<style>
  .post {
    padding-bottom: 48px;
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 70vh;
  }
  .embed iframe {
    width: 100%;
    height: 100%;
  }
  h1 {
    margin-top: 32px;
    max-width: 680px;
  }
  .audio {
    width: 100%;
    max-width: 680px;
  }
  .content {
    max-width: 680px;
    margin: 32px 0;
  }
  .tags {
    text-transform: uppercase;
    font-size: 0.8rem;
  }
</style>
