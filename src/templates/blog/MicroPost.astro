---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostMeta from '../../components/PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, date, categories, tags, heroImage } = post.data;
const { Content } = await render(post);
---

<article class="post">
  <PostMeta date={date} categories={categories} />
  <h1>{title}</h1>

  {heroImage && (
    <Image class="lightbox-img hero-image" src={heroImage} alt={title} width={Math.min(heroImage.width, 800)} />
  )}

  <div class="content" data-reveal>
    <Content />
  </div>

  {tags.length > 0 && <p class="muted tags">{tags.join(' · ')}</p>}

  <p><a href="/blog/">← Back to blog</a></p>
</article>

<style>
  .post {
    padding: 64px 0;
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }
  .post h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin: 8px 0 24px;
  }
  .content {
    margin: 28px 0;
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .content :global(img) {
    margin: 20px auto;
  }
  .tags {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
</style>
