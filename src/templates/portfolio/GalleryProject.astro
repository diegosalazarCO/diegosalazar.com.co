---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectMeta from '../../components/ProjectMeta.astro';
import ProjectNav from '../../components/ProjectNav.astro';

interface Props {
  project: CollectionEntry<'portfolio'>;
  prev: CollectionEntry<'portfolio'>;
  next: CollectionEntry<'portfolio'>;
}
const { project, prev, next } = Astro.props;
const { title, client, role, category, tags, date, link, linkLabel, heroImage, gallery } = project.data;
const { Content } = await render(project);
---

<article class="item">
  <h1>{title}</h1>
  <Image class="lightbox-img hero-image" src={heroImage} alt={title} width={Math.min(heroImage.width, 1300)} />

  <div class="content" data-reveal>
    <Content />
  </div>

  {gallery.length > 0 && (
    <div class="gallery">
      {gallery.map((img) => (
        <Image class="lightbox-img" src={img} alt={title} width={Math.min(img.width, 500)} />
      ))}
    </div>
  )}

  {link && (
    <p>
      <a class="accent" href={link} target="_blank" rel="noopener">
        {linkLabel ?? 'Visit website'} →
      </a>
    </p>
  )}

  <ProjectMeta client={client} role={role} category={category} date={date} tags={tags} />
  <ProjectNav prev={prev} next={next} />
</article>

<style>
  .item {
    padding: 48px 0;
  }
  .content {
    max-width: 680px;
    margin: 32px 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 4px;
    margin: 32px 0;
  }
  .gallery :global(img) {
    aspect-ratio: 1;
    width: 100%;
    background: #000;
    object-fit: contain;
  }
</style>
