---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'portfolio'>[];
}
const { projects } = Astro.props;

const previews = await Promise.all(
  projects.map(async (project) => {
    const img = await getImage({ src: project.data.heroImage, width: 500, height: 500 });
    return { id: project.id, title: project.data.title, src: img.src };
  })
);
---

<section class="text-list" id="text-list">
  <ul>
    {projects.map((project, i) => (
      <li>
        <a href={`/portfolio-item/${project.id}/`} class="list-link" data-preview={i}>
          {project.data.title}
        </a>
      </li>
    ))}
  </ul>

  <div class="preview" id="preview">
    {previews.map((p, i) => (
      <img src={p.src} alt={p.title} data-index={i} />
    ))}
  </div>
</section>

<style>
  .text-list {
    position: relative;
    padding: 56px 0 96px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 24px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 48px;
    row-gap: 4px;
  }
  li {
    width: auto;
  }
  .list-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 5.5vw, 3.4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    padding: 4px 0;
    transition: color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .list-link:hover,
  .list-link:focus-visible {
    color: var(--color-accent);
    transform: translateX(12px);
  }
  .preview {
    position: fixed;
    top: 0;
    left: 0;
    width: min(300px, 36vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) scale(0.9);
    pointer-events: none;
    z-index: 40;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .preview.visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .preview img.active {
    opacity: 1;
  }
</style>

<script>
  const container = document.getElementById('text-list');
  const preview = document.getElementById('preview');
  const images = document.querySelectorAll<HTMLImageElement>('.preview img');
  let activeIndex: string | null = null;

  container?.addEventListener('mousemove', (e) => {
    if (!preview) return;
    preview.style.left = `${e.clientX}px`;
    preview.style.top = `${e.clientY}px`;

    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.list-link');
    const index = link?.dataset.preview ?? null;
    if (index !== activeIndex) {
      activeIndex = index;
      images.forEach((img) => img.classList.toggle('active', img.dataset.index === activeIndex));
    }
    preview.classList.toggle('visible', index !== null);
  });

  container?.addEventListener('mouseleave', () => {
    activeIndex = null;
    preview?.classList.remove('visible');
  });
</script>
