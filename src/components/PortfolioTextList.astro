---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'portfolio'>[];
}
const { projects } = Astro.props;

const previews = await Promise.all(
  projects.map(async (project) => {
    const preview = project.data.thumbnail ?? project.data.heroImage;
    const img = await getImage({ src: preview, width: Math.min(preview.width, 500) });
    return { id: project.id, title: project.data.title, src: img.src };
  })
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="work" id="text-list">
  <ul class="rows">
    {projects.map((project, i) => (
      <li data-reveal>
        <a href={`/portfolio-item/${project.id}/`} class="row list-link" data-preview={i}>
          <span class="label">{pad(i + 1)}</span>
          <span class="row-title">{project.data.title}</span>
          <span class="label row-aside">
            {project.data.category.split(' ').join(' / ')} · {project.data.date.getFullYear()}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="preview" id="preview">
    {previews.map((p, i) => (
      <img src={p.src} alt="" data-index={i} loading="lazy" />
    ))}
  </div>
</div>

<style>
  .row-title {
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
  }
  .list-link:hover,
  .list-link:focus-visible {
    color: var(--color-accent);
  }
  .preview {
    position: fixed;
    top: 0;
    left: 0;
    width: min(300px, 30vw);
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    transform: translate(24px, -50%) scale(0.94);
    pointer-events: none;
    z-index: 40;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .preview.visible {
    opacity: 1;
    transform: translate(24px, -50%) scale(1);
  }
  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .preview img.active {
    opacity: 1;
  }
  @media (hover: none) {
    .preview {
      display: none;
    }
  }
</style>

<script>
  const container = document.getElementById('text-list');
  const preview = document.getElementById('preview');
  const images = document.querySelectorAll<HTMLImageElement>('.preview img');
  let activeIndex: string | null = null;

  container?.addEventListener('mousemove', (e) => {
    if (!preview) return;
    // keep the card on screen: flip to the left of the cursor near the right edge
    const flip = e.clientX + preview.offsetWidth + 48 > window.innerWidth;
    preview.style.left = `${flip ? e.clientX - preview.offsetWidth - 48 : e.clientX}px`;
    preview.style.top = `${e.clientY}px`;

    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.list-link');
    const index = link?.dataset.preview ?? null;
    if (index !== activeIndex) {
      activeIndex = index;
      images.forEach((img) => img.classList.toggle('active', img.dataset.index === activeIndex));
    }
    preview.classList.toggle('visible', index !== null);
  });

  container?.addEventListener('mouseleave', () => {
    activeIndex = null;
    preview?.classList.remove('visible');
  });
</script>
