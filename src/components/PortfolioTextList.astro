---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'portfolio'>[];
}
const { projects } = Astro.props;

const previews = await Promise.all(
  projects.map(async (project) => {
    const img = await getImage({ src: project.data.heroImage, width: 500, height: 500 });
    return { id: project.id, title: project.data.title, src: img.src };
  })
);
---

<section class="text-list">
  <ul>
    {projects.map((project, i) => (
      <li>
        <a href={`/portfolio-item/${project.id}/`} class="list-link" data-preview={i}>
          {project.data.title}
        </a>
      </li>
    ))}
  </ul>

  <div class="preview" id="preview">
    {previews.map((p, i) => (
      <img src={p.src} alt={p.title} data-index={i} />
    ))}
  </div>
</section>

<style>
  .text-list {
    position: relative;
    padding: 48px 0 80px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0 24px;
  }
  .list-link {
    display: block;
    font-size: clamp(1.6rem, 5vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    padding: 6px 0;
    transition: color 0.2s ease;
  }
  .list-link:hover,
  .list-link:focus-visible {
    color: var(--color-accent);
  }
  .preview {
    position: fixed;
    top: 50%;
    left: 50%;
    width: min(320px, 40vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 40;
  }
  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .preview img.active {
    opacity: 1;
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.list-link');
  const images = document.querySelectorAll<HTMLImageElement>('.preview img');

  links.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      const index = link.dataset.preview;
      images.forEach((img) => img.classList.toggle('active', img.dataset.index === index));
    });
    link.addEventListener('mouseleave', () => {
      images.forEach((img) => img.classList.remove('active'));
    });
  });
</script>
