---
import { mailto } from '../lib/constants';
import ClientsMarquee from './ClientsMarquee.astro';
---

<footer class="site-footer">
  <div class="wrap clients">
    <p class="eyebrow muted">Companies I've worked with</p>
    <ClientsMarquee />
  </div>

  <div class="wrap bottom">
    <a class="accent link-underline" href={mailto()}>Contact me</a>
    <p class="muted">&copy; {new Date().getFullYear()} Diego Alexander Salazar.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
  }
  .clients {
    padding: 32px 0;
  }
  .eyebrow {
    text-align: center;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin: 0 0 20px;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--color-border);
    padding: 24px 0 48px;
  }
  .bottom a {
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.9rem;
  }
</style>
