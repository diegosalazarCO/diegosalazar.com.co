---
import { CONTACT_EMAIL, mailto } from '../lib/constants';
import ClientsMarquee from './ClientsMarquee.astro';
import Section from './Section.astro';

const links = [
  { href: '/portfolio/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/shop/', label: 'Prints' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <Section index="→" label="Worked with">
      <ClientsMarquee />
    </Section>

    <Section index="→" label="Contact">
      <a class="mail" href={mailto()}>{CONTACT_EMAIL}</a>
    </Section>

    <div class="base">
      <p class="label">© {new Date().getFullYear()} Diego Alexander Salazar</p>
      <nav class="links" aria-label="Footer">
        {links.map((link) => (
          <a href={link.href} class="label link-underline">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer :global(.section) {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .mail {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4.2vw, 3.4rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    border-top: 1px solid var(--color-border);
    padding: 14px 0 96px;
  }
  .links {
    display: flex;
    gap: 28px;
  }
</style>
