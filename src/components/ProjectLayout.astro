---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="project-layout">
  <div class="section-head">
    <span class="label">00</span>
    <span class="label">Work</span>
    <a class="label link-underline" href="/portfolio/">Index</a>
  </div>
  <h1>{title}</h1>

  <div class="split">
    <div class="media-col">
      <slot name="media" />
    </div>
    <div class="desc-col" data-reveal>
      <slot />
    </div>
  </div>
</article>

<style>
  .project-layout {
    padding: clamp(40px, 7vw, 96px) 0 48px;
  }
  h1 {
    margin: 0 0 clamp(28px, 4vw, 56px);
  }
  .split {
    display: grid;
    gap: 40px;
  }
  .desc-col {
    max-width: 680px;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
      gap: 56px;
    }
    .desc-col {
      position: sticky;
      top: calc(var(--header-h) + 32px);
      max-width: none;
    }
  }
</style>
