---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { excerpt, isSoundcloud, youtubeThumbnail } from '../lib/embed';

interface Props {
  post: CollectionEntry<'blog'>;
  aspect?: 'tall' | 'square' | 'wide';
}

const { post, aspect = 'square' } = Astro.props;
const { title, date, categories, heroImage, embedUrl, audioUrl, videoUrl, source, layout } = post.data;
const isInteractive = layout === 'fullscreen';
const href = `/blog/${post.id}/`;
const hasMedia = Boolean(embedUrl || audioUrl || videoUrl);
const videoThumb = youtubeThumbnail(embedUrl);
const kind = source === 'twitter' ? 'tweet' : isSoundcloud(embedUrl) ? 'audio' : videoThumb ? 'video' : 'default';
---

<article class="post" data-categories={`|${categories.join('|')}|`}>
  {kind === 'audio' && (
    <div class="media audio">
      <iframe src={embedUrl} title={title} frameborder="0" loading="lazy"></iframe>
    </div>
  )}
  {kind === 'tweet' && (
    <a class="media tweet" href={href} tabindex="-1" aria-hidden="true">
      <span class="tweet-source">From Twitter</span>
      <p class="tweet-text">{excerpt(post.body)}</p>
    </a>
  )}
  {kind === 'video' && (
    <a class="media video" href={href} tabindex="-1" aria-hidden="true">
      <img src={videoThumb} alt="" loading="lazy" />
      <span class="badge">▶</span>
    </a>
  )}
  {kind === 'default' && (
    <a class={`media ${heroImage ? aspect : `text-only ${aspect}`}`} href={href} tabindex="-1" aria-hidden="true">
      {heroImage ? (
        <Image src={heroImage} alt="" width={Math.min(heroImage.width, 600)} />
      ) : (
        <span class="tile-title">{title}</span>
      )}
      {(isInteractive || !heroImage) && (
        <span class="glass-badge notes-badge glass">
          {isInteractive ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            </svg>
          ) : (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M9 7H6a3 3 0 0 0 0 6h3M15 7h3a3 3 0 0 1 0 6h-3M8 10h8" />
            </svg>
          )}
          {isInteractive ? 'Interactive' : 'Notes'}
        </span>
      )}
      {hasMedia && <span class="badge">▶</span>}
    </a>
  )}
  <div class="info">
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">
      {formatDate(date)}
      {categories.length > 0 && <span> · {categories.join(', ')}</span>}
    </p>
  </div>
</article>

<style>
  .post {
    display: block;
    break-inside: avoid;
    margin-bottom: 32px;
  }
  .post.is-hidden {
    display: none;
  }
  .media {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--color-border);
  }
  .media.tall {
    aspect-ratio: 3 / 4;
  }
  .media.square {
    aspect-ratio: 1;
  }
  .media.wide {
    aspect-ratio: 4 / 3;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s var(--ease-out);
  }
  .post:hover .media :global(img) {
    transform: scale(1.08);
  }
  .media.video {
    aspect-ratio: 16 / 9;
  }
  .media.video img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* crops the letterbox bars baked into YouTube's hqdefault */
  }
  .media.audio {
    height: 300px;
  }
  .media.audio iframe {
    width: 100%;
    height: 100%;
    display: block;
  }
  .media.tweet {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 220px;
    padding: 20px;
    background: linear-gradient(155deg, #1c1c1c, var(--color-bg));
    border: 1px solid var(--color-border);
    transition: border-color 0.25s ease;
  }
  .post:hover .media.tweet {
    border-color: var(--color-accent);
  }
  .tweet-source {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .tweet-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .text-only {
    display: flex;
    align-items: flex-end;
    padding: 20px;
    background: linear-gradient(155deg, #1c1c1c, var(--color-bg));
    border: 1px solid var(--color-border);
    transition: border-color 0.25s ease;
  }
  .post:hover .text-only {
    border-color: var(--color-accent);
  }
  .notes-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    color: var(--color-text);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .post:hover .notes-badge {
    background: var(--glass-bg-strong);
    border-color: var(--color-accent);
  }
  .tile-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-text);
    font-size: 0.7rem;
  }
  .info {
    padding-top: 14px;
  }
  .post h3 {
    margin: 0 0 4px;
    font-size: 1.1rem;
  }
  .info p {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
