---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
  aspect?: 'tall' | 'square' | 'wide';
}

const { project, aspect = 'square' } = Astro.props;
const { title, category, heroImage } = project.data;
const categoryParts = category.split(' ');
const categorySlugs = categoryParts.map((c) => c.toLowerCase()).join(' ');
---

<a class="card" href={`/portfolio-item/${project.id}/`} data-categories={categorySlugs}>
  <div class={`frame ${aspect}`}>
    <Image src={heroImage} alt={title} width={Math.min(heroImage.width, 640)} />
  </div>
  <div class="info">
    <h3>{title}</h3>
    <p class="muted category">{categoryParts.join(' / ')}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    break-inside: avoid;
    margin-bottom: 40px;
  }
  .card.is-hidden {
    display: none;
  }
  .frame {
    overflow: hidden;
    background: #000;
    border: 6px solid var(--color-border);
    transition: border-color 0.25s ease;
  }
  .frame.tall {
    aspect-ratio: 3 / 4;
  }
  .frame.square {
    aspect-ratio: 1;
  }
  .frame.wide {
    aspect-ratio: 4 / 3;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s var(--ease-out);
  }
  .card:hover .frame {
    border-color: var(--color-text);
  }
  .card:hover .frame img {
    transform: scale(1.08);
  }
  .info {
    padding-top: 16px;
    text-align: center;
  }
  .card h3 {
    margin: 0 0 4px;
  }
  .category {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
</style>
