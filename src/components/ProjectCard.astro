---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, category, heroImage } = project.data;
const categoryParts = category.split(' ');
const categorySlugs = categoryParts.map((c) => c.toLowerCase()).join(' ');
---

<a class="card" href={`/portfolio-item/${project.id}/`} data-categories={categorySlugs}>
  <div class="frame">
    <Image src={heroImage} alt={title} width={Math.min(heroImage.width, 640)} />
  </div>
  <div class="info glass">
    <h3>{title}</h3>
    <p class="muted category">{categoryParts.join(' / ')}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    break-inside: avoid;
    margin-bottom: 24px;
    border-radius: var(--radius-glass);
    overflow: hidden;
  }
  .card.is-hidden {
    display: none;
  }
  .frame {
    overflow: hidden;
    background: #000;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }
  .card:hover .frame img {
    transform: scale(1.05);
  }
  .info {
    padding: 14px 18px 16px;
    border-top: none;
  }
  .card h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }
  .category {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>
