---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, category, heroImage, thumbnail } = project.data;
const cardImage = thumbnail ?? heroImage;
const categoryParts = category.split(' ');
const categorySlugs = categoryParts.map((c) => c.toLowerCase()).join(' ');
---

<a class="card" href={`/portfolio-item/${project.id}/`} data-categories={categorySlugs}>
  <div class="frame">
    <Image src={cardImage} alt={title} width={Math.min(cardImage.width, 640)} />
  </div>
  <div class="info">
    <h3>{title}</h3>
    <p class="label">{categoryParts.join(' / ')}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    break-inside: avoid;
    margin-bottom: 32px;
  }
  .card.is-hidden {
    display: none;
  }
  .frame {
    overflow: hidden;
    background: var(--color-surface);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }
  .card:hover .frame img {
    transform: scale(1.05);
  }
  .info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0 0;
  }
  .card h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .card:hover h3 {
    color: var(--color-accent);
  }
</style>
