---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, category, heroImage } = project.data;
const categoryParts = category.split(' ');
---

<a class="card" href={`/portfolio-item/${project.id}/`}>
  <div class="frame">
    <Image src={heroImage} alt={title} width={640} height={480} />
  </div>
  <div class="info">
    <h3>{title}</h3>
    <p class="muted category">{categoryParts.join(' / ')}</p>
  </div>
</a>

<style>
  .card {
    display: block;
  }
  .frame {
    border: 6px solid var(--color-border);
    transition: border-color 0.2s ease;
  }
  .card:hover .frame {
    border-color: var(--color-text);
  }
  .info {
    padding-top: 16px;
    text-align: center;
  }
  .card h3 {
    margin: 0 0 4px;
  }
  .category {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
</style>
