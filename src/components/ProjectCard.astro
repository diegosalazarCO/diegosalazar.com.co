---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, category, heroImage } = project.data;
const categoryParts = category.split(' ');
const categorySlugs = categoryParts.map((c) => c.toLowerCase()).join(' ');
---

<a class="card" href={`/portfolio-item/${project.id}/`} data-categories={categorySlugs}>
  <div class="frame">
    <Image src={heroImage} alt={title} width={640} height={480} />
  </div>
  <div class="info">
    <h3>{title}</h3>
    <p class="muted category">{categoryParts.join(' / ')}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .card.is-hidden {
    display: none;
  }
  .frame {
    overflow: hidden;
    border: 6px solid var(--color-border);
    transition: border-color 0.25s ease;
  }
  .frame img {
    transition: transform 0.5s var(--ease-out);
  }
  .card:hover .frame {
    border-color: var(--color-text);
  }
  .card:hover .frame img {
    transform: scale(1.08);
  }
  .info {
    padding-top: 16px;
    text-align: center;
  }
  .card h3 {
    margin: 0 0 4px;
  }
  .category {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
</style>
