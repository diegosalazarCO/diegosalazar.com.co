---
const navItems = [
  { href: '/portfolio/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/shop/', label: 'Prints' },
  { href: '/ink/', label: 'Ink' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(href) || (href === '/portfolio/' && current.startsWith('/portfolio-item/'));
---

<header class="site-header" id="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="Diego Alexander Salazar, home">DIEGO</a>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} class="label link-underline" aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <button class="menu-toggle label" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .site-header.scrolled,
  .site-header.open {
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }
  .bar {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .nav {
    display: flex;
    gap: 32px;
  }
  .nav a {
    color: var(--color-text);
  }
  .nav a[aria-current='page'] {
    color: var(--color-accent);
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 12px 0 12px 12px;
    color: var(--color-text);
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .menu-toggle {
      display: block;
    }
    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      display: none;
    }
    .site-header.open .nav {
      display: flex;
    }
    .nav a {
      padding: 16px var(--gutter);
      border-top: 1px solid var(--color-border);
    }
    .nav a::after {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close' : 'Menu';
  });
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
