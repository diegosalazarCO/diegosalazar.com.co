---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/shop/', label: 'Shop' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">Diego Alexander Salazar</a>
    <nav>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="mailto:hola@diegosalazar.com.co?subject=Hi! This is a contact from your website">Contact me</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    padding: 20px 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  nav {
    display: flex;
    gap: 20px;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
</style>
