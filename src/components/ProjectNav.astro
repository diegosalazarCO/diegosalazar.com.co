---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev: CollectionEntry<'portfolio'>;
  next: CollectionEntry<'portfolio'>;
}
const { prev, next } = Astro.props;
---

<nav class="project-nav">
  <a href={`/portfolio-item/${prev.id}/`} class="prev">
    <span class="muted label">← Previous</span>
    <span class="proj-title">{prev.data.title}</span>
  </a>
  <a href="/portfolio/" class="all">All projects</a>
  <a href={`/portfolio-item/${next.id}/`} class="next">
    <span class="muted label">Next →</span>
    <span class="proj-title">{next.data.title}</span>
  </a>
</nav>

<style>
  .project-nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .project-nav a {
    transition: color 0.25s var(--ease-out);
  }
  .prev,
  .next {
    display: flex;
    flex-direction: column;
  }
  .next {
    align-items: flex-end;
    text-align: right;
  }
  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .proj-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
  }
  .all {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    order: 3;
  }
  @media (min-width: 640px) {
    .project-nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .all {
      order: 2;
    }
    .next {
      order: 3;
    }
  }
</style>
