---
interface Props {
  title: string;
  tagline: string;
  /** Short facts shown as the mono strip along the bottom edge. */
  facts?: string[];
}
const { title, tagline, facts = [] } = Astro.props;
---

<section class="hero full-bleed" id="hero">
  <!-- Source for the WebGL backdrop (src/backdrop). Stays visible as the hero when WebGL is unavailable. -->
  <video class="hero-video" id="hero-video" src="/videos/hero.mp4" autoplay loop muted playsinline preload="auto"></video>

  <div class="hero-content wrap">
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>
  </div>

  <div class="hero-foot wrap">
    <button class="video-toggle label" id="video-toggle" aria-label="Pause background film">
      <span class="icon-pause">Pause film</span>
      <span class="icon-play">Play film</span>
    </button>
    <ul class="facts">
      {facts.map((fact) => <li class="label">{fact}</li>)}
    </ul>
    <a class="label scroll-cue" href="#work">Scroll ↓</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: calc(var(--header-h) * -1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55);
    transition: opacity 0.8s var(--ease-out);
  }
  /* Once the backdrop is drawing the film, the plain element only feeds it */
  :global(.has-backdrop) .hero-video {
    opacity: 0;
  }
  @media (max-width: 640px) {
    .hero-video {
      object-position: left center;
    }
  }
  .hero-content {
    position: relative;
    width: 100%;
    padding-bottom: clamp(28px, 5vw, 56px);
  }
  h1 {
    font-size: clamp(2.4rem, 5.2vw, 4.6rem);
    line-height: 0.95;
    margin: 0 0 clamp(14px, 1.6vw, 22px);
  }
  .tagline {
    max-width: 44ch;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }
  .hero-foot {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    padding-bottom: 18px;
  }
  .hero-foot::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--color-border);
  }
  .hero-foot .label {
    color: var(--color-text);
  }
  .facts {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }
  .video-toggle {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .video-toggle:hover,
  .scroll-cue:hover {
    color: var(--color-accent);
  }
  .video-toggle .icon-play,
  .video-toggle.paused .icon-pause {
    display: none;
  }
  .video-toggle.paused .icon-play {
    display: inline;
  }
  @media (max-width: 720px) {
    .facts {
      display: none;
    }
  }
</style>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('video-toggle');

  // Safari (especially Private Browsing) can silently reject a muted autoplay
  // attempt. Retry on the first user gesture, which it always honors.
  function attemptPlay() {
    if (!video) return;
    video.muted = true;
    video.play().catch(() => {
      const retry = () => video.play().catch(() => {});
      ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach((type) =>
        document.addEventListener(type, retry, { once: true, passive: true })
      );
    });
  }
  attemptPlay();

  toggle?.addEventListener('click', () => {
    if (!video) return;
    if (video.paused) {
      video.play();
      toggle.classList.remove('paused');
      toggle.setAttribute('aria-label', 'Pause background film');
    } else {
      video.pause();
      toggle.classList.add('paused');
      toggle.setAttribute('aria-label', 'Play background film');
    }
  });
</script>
