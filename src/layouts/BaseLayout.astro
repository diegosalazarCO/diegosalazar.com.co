---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import MusicToggle from '../components/MusicToggle.astro';
import Lightbox from '../components/Lightbox.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Backdrop from '../backdrop/Backdrop.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * The page brings its own chrome: no header, footer, backdrop or floating widgets.
   * `true` also locks the viewport (fullscreen posts); `'scroll'` leaves the document scrolling
   * (the ink flight is driven by it).
   */
  immersive?: boolean | 'scroll';
}

const {
  title,
  description = 'Diego Alexander Salazar — Tech creative and product developer.',
  immersive = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Rajdhani:wght@300;500;600;700&family=Roboto+Condensed:ital,wght@0,300;0,400;0,700;1,300&display=swap"
      rel="stylesheet"
    />
    <title>{title} — Diego Alexander Salazar</title>
    <meta name="description" content={description} />
  </head>
  <body class:list={{ immersive: immersive === true }}>
    {immersive ? (
      <main>
        <slot />
      </main>
    ) : (
      <>
        <Backdrop />
        <Header />
        <main class="wrap page">
          <slot />
        </main>
        <Footer />
        <BackToTop />
        <MusicToggle />
        <Lightbox />
        <ScrollReveal />
      </>
    )}
  </body>
</html>
