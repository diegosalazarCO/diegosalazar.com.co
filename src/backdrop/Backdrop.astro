---
import { getImage } from 'astro:assets';
import still from '../assets/backdrop/still.jpg';

// A still of the hero film: the texture on every page that has no film playing.
const { src } = await getImage({ src: still, width: 960 });
---

<canvas class="backdrop" id="backdrop" data-still={src} aria-hidden="true"></canvas>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .backdrop.ready {
    opacity: 1;
  }
</style>

<script>
  const canvas = document.getElementById('backdrop') as HTMLCanvasElement | null;
  const hero = document.getElementById('hero');
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;

  async function boot() {
    if (!canvas || reduced || saveData) return;
    try {
      // three.js stays out of the initial bundle; the page is already readable before this resolves
      const { mountBackdrop } = await import('./backdrop');
      await mountBackdrop({ canvas, source: video ?? canvas.dataset.still!, hero });
      canvas.classList.add('ready');
      document.documentElement.classList.add('has-backdrop');
    } catch {
      // No WebGL: the hero keeps its plain <video>, other pages keep the flat background.
    }
  }

  if (video && video.readyState < 2) video.addEventListener('loadeddata', boot, { once: true });
  else if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1500 });
  else setTimeout(boot, 200);
</script>
